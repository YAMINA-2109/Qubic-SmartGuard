# .env.example
# Qubic SmartGuard Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM API Configuration
# =============================================================================
GROQ_API_KEY=your_groq_key_here
LANGCHAIN_API_KEY=your_langchain_key_here
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# QUBIC NETWORK CONFIGURATION
# =============================================================================
# Qubic RPC Endpoint for real network integration
QUBIC_RPC_URL=https://rpc.qubic.org
QUBIC_NETWORK_ID=mainnet
QUBIC_TESTNET_RPC_URL=https://testnet-rpc.qubic.org

# =============================================================================
# SECURITY ANALYSIS CONFIGURATION
# =============================================================================
# Enable/disable features
ENABLE_LLM_ANALYSIS=true
ENABLE_REAL_NETWORK=false
ENABLE_DEBUG_MODE=false

# Analysis thresholds
MIN_SECURITY_SCORE=70
CRITICAL_VULNERABILITY_THRESHOLD=0
HIGH_RISK_THRESHOLD=2

# Ollama Configuration (if using local models)
OLLAMA_HOST=http://localhost:11434

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Python Path
PYTHONPATH=/workspace:/workspace/src

# Development Mode
DEBUG=true
DEVELOPMENT_MODE=true

# File Upload Configuration
MAX_UPLOAD_SIZE=10MB
ALLOWED_EXTENSIONS=.cpp,.h,.hpp,.c

# Security Settings
SECURITY_SCAN_ENABLED=true
VALIDATION_STRICT=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
